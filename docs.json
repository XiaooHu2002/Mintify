{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "严千屹",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/fluid.png",
    "dark": "/images/fluid.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "languages": [
      {
        "language": "zh-CN",
        "pages": [
          "userGroup"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/fluid.png",
    "dark": "/images/fluid.png"
  },
  "navbar": {
    "links": [
      {
        "href": "https://blog.qianyios.top",
        "label": "严千屹博客"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "styling": {
    "latex": true
  },
  "interaction": {
    "drilldown": false
  }
}
